Options -Indexes
DirectoryIndex index.php

# Allow photos up to 4 MB (only applied when PHP runs as an Apache module, e.g. XAMPP)
<IfModule mod_php.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 12M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 12M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 12M
</IfModule>
